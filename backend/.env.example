# 环境说明（本文件可提交；含密码的文件勿提交）
#
# 本地开发（默认）：复制为 .env.dev 并填写
#   copy .env.dev.example .env.dev
# 线上生产：复制为 .env.prod 并填写；启动时设 SPRING_PROFILES_ACTIVE=prod
#   copy .env.prod.example .env.prod
#
# 兼容：仍可读旧的 backend/.env（无 .env.{profile} 时回退）

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=studyApp
MYSQL_USER=studyapp
MYSQL_PASSWORD=change_me
SERVER_PORT=8080

# Optional: Gitee personal access token (raises API rate limit).
# GITEE_ACCESS_TOKEN=

# 拓展对话（仅服务端；不要写成 VITE_*，不要放进前端）
# 使用 OpenAI 兼容的 Chat Completions（POST {AI_BASE_URL}/chat/completions）
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
# AI_TIMEOUT_SECONDS=60
#
# AI_MODEL 必须填写你实际开通的提供商控制台中的模型 ID，不要编造。
# 三项都为空时，App 内「拓展」会显示未配置，不会假装已回复。
