# Copy to backend/.env and fill in (gitignored)

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=appdemo
MYSQL_USER=appdemo
MYSQL_PASSWORD=change_me
SERVER_PORT=8080

# Optional: Gitee personal access token (raises API rate limit).
# Vite injects it on /git-proxy/gitee api/v5 only — never bundled into frontend.
# Create at: https://gitee.com/profile/personal_access_tokens (scope: projects)
# GITEE_ACCESS_TOKEN=