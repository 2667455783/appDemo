# 环境说明（本文件可提交；含密码的文件勿提交）
#
# 本地开发（默认）：复制为 .env.dev 并填写
#   copy .env.dev.example .env.dev
# 线上生产：复制为 .env.prod 并填写；启动时设 SPRING_PROFILES_ACTIVE=prod
#   copy .env.prod.example .env.prod
#
# 兼容：仍可读旧的 backend/.env（无 .env.{profile} 时回退）

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=studyApp
MYSQL_USER=studyapp
MYSQL_PASSWORD=change_me
SERVER_PORT=8080

# Optional: Gitee personal access token (raises API rate limit).
# GITEE_ACCESS_TOKEN=
