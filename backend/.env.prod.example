# 复制为 backend/.env.prod（已 gitignore）
# 线上启动：SPRING_PROFILES_ACTIVE=prod java -jar appdemo-backend.jar
# 或：java -Dspring.profiles.active=prod -jar appdemo-backend.jar

MYSQL_HOST=your.prod.host.or.ip
MYSQL_PORT=3306
MYSQL_DATABASE=studyApp
MYSQL_USER=studyapp
MYSQL_PASSWORD=change_me
SERVER_PORT=8080

